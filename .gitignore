# ============================================================================
#  Personal library data — NEVER publish. These are generated from YOUR Zotero
#  and your own notes. The folder structure is kept (via .gitkeep) but contents
#  are ignored so a fresh clone starts empty.
# ============================================================================
/Literature/*
/Topics/*
/Inbox/*
/Daily/*
/Research/*
!**/.gitkeep

# Agent state & caches (machine-local)
Inbox/.feedback.jsonl
Inbox/.surfaced.txt
Inbox/.last_fetch.json
Inbox/.digest.json
Inbox/.pdfcache/

# Generated graphs
Daily/*-graph.html

# Python
__pycache__/
*.py[cod]

# Logs
*.log

# Machine-specific scheduled-job files (generated by tools/install_schedule.sh)
deploy/*.local.plist

# OS / editor cruft
.DS_Store
.idea/
.vscode/
*.swp
